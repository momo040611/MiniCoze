{
  "name": "minicoze",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter backend start:dev",
    "build:web": "pnpm --filter web build",
    "preview:web": "pnpm --filter web preview",
    "lint:web": "pnpm --filter web lint",
    "deploy:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/upload.ps1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

