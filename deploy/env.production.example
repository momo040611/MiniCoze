# ============================================================
# MiniCoze 后端生产环境变量模板
# 用法：cp deploy/env.production.example apps/backend/.env
# 然后把下面 3 个 "<...>" 占位符换成真实值
# ============================================================

NODE_ENV=production
PORT=3000

# 由 deploy/00-init-server.sh 生成，查看：cat /root/minicoze-credentials.txt
DATABASE_URL="postgresql://minicoze:<DB_PASSWORD>@127.0.0.1:5432/minicoze?schema=public"

# 必须是 32 位以上随机字符串，否则启动会直接报错（env.validation 有强校验）
# 生成：openssl rand -hex 32
JWT_SECRET="<64_HEX_CHARS_RANDOM_STRING>"
JWT_EXPIRES_IN="2h"

# 加密数据库里的模型凭证（AES-256-GCM），生产环境必填，缺失会直接启动失败：
#   BusinessException: SECRET_ENCRYPTION_KEY is required in production
# 生成：openssl rand -hex 32
# ⚠️ 设定后不要再改，否则库里已加密的凭证全部解不开
SECRET_ENCRYPTION_KEY="<64_HEX_CHARS_RANDOM_STRING>"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 同域部署时前端不跨域；填你的域名，没有域名就填服务器 IP
CORS_ORIGIN="http://101.200.30.115"

# ---------- 文件存储 ----------
# local：存在服务器本地磁盘，需要定期备份 apps/backend/storage
# cos：存腾讯云 COS（更稳，建议后续切）
FILE_STORAGE_DRIVER=local
FILE_UPLOAD_DIR=storage/uploads
FILE_PUBLIC_BASE_URL=/api/files
FILE_MAX_IMAGE_SIZE=5242880
FILE_MAX_DOCUMENT_SIZE=52428800

# 用 cos 时填以下四项，并把 FILE_STORAGE_DRIVER 改成 cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PUBLIC_BASE_URL=

# ---------- AI 模型 ----------
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=<你的 deepseek key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 知识库 / Embedding ----------
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=<你的 embedding key>
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------- 其它能力 ----------
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
BING_SEARCH_TIMEOUT_MS=10000

IMAGE_UNDERSTANDING_API_KEY=
IMAGE_UNDERSTANDING_BASE_URL=https://api.openai.com/v1
IMAGE_UNDERSTANDING_MODEL=gpt-4o-mini
IMAGE_UNDERSTANDING_TIMEOUT_MS=20000

LINK_READER_TIMEOUT_MS=15000
LINK_READER_MAX_CHARS=20000
