generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  createdAgents Agent[]
  conversations Conversation[]

  knowledgeBases KnowledgeBase[]
  uploadStages   KnowledgeUploadStage[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  agents  Agent[]

  knowledgeBases KnowledgeBase[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Agent {
  id             String      @id @default(cuid())
  workspaceId    String
  creatorId      String
  name           String
  description    String?
  avatarUrl      String?
  systemPrompt   String      @db.Text
  model          String      @default("deepseek-v4-flash")
  temperature    Float       @default(0.7)
  openingMessage String?     @db.Text
  contextLimit   Int         @default(20)
  status         AgentStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  title     String?
  isPreview Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
  @@index([userId])
  @@index([agentId, userId, isPreview])
  @@index([agentId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  tokenUsage     Json?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model KnowledgeBase {
  id             String   @id @default(cuid())
  workspaceId    String
  creatorId      String
  name           String
  description    String?
  embeddingModel String
  embeddingDim   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User                @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  documents KnowledgeDocument[]

  @@index([workspaceId])
  @@index([creatorId])
}

model KnowledgeDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  originalName    String
  fileExtension   String
  fileSize        Int
  chunkType       String
  chunkConfig     Json
  totalChunks     Int
  totalChars      Int
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, createdAt])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String                       @db.Text
  charCount  Int
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// 文档上传 stage：用户先上传文件拿到 fileId，
// 后续切分预览/入库都用 fileId 引用，避免重复传文件。
// TTL 24h，由 UploadStageService 通过 cron + 启动钩子兜底清理。
model KnowledgeUploadStage {
  id            String   @id @default(cuid())
  fileId        String   @unique
  uploaderId    String
  originalName  String
  fileExtension String
  fileSize      Int
  storagePath   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([expiresAt])
}

