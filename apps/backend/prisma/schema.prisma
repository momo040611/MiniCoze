generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  createdAgents    Agent[]
  conversations    Conversation[]
  uploadedFiles    FileAsset[]       @relation("FileAssetOwner")
  createdWorkflows Workflow[]        @relation("WorkflowCreator")
  workflowVersions WorkflowVersion[] @relation("WorkflowVersionCreator")
  workflowRuns     WorkflowRun[]     @relation("WorkflowRunUser")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  agents    Agent[]
  workflows Workflow[]        @relation("WorkspaceWorkflows")
  files     FileAsset[]       @relation("WorkspaceFiles")

  @@index([ownerId])
}

enum FilePurpose {
  AVATAR
  KNOWLEDGE_DOCUMENT
  CHAT_ATTACHMENT
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum FileStatus {
  READY
  DELETED
}

model FileAsset {
  id           String         @id @default(cuid())
  workspaceId  String?
  ownerId      String
  purpose      FilePurpose
  visibility   FileVisibility @default(PRIVATE)
  status       FileStatus     @default(READY)
  originalName String
  storageKey   String
  url          String?
  mimeType     String
  extension    String?
  size         Int
  checksum     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner     User       @relation("FileAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation("WorkspaceFiles", fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([workspaceId])
  @@index([purpose])
  @@index([status])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowVersionStatus {
  ACTIVE
  DEPRECATED
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum WorkflowRunSource {
  DEBUG
  AGENT
  API
}

model Agent {
  id             String      @id @default(cuid())
  workspaceId    String
  creatorId      String
  name           String
  description    String?
  avatarUrl      String?
  systemPrompt   String      @db.Text
  model          String      @default("deepseek-v4-flash")
  temperature    Float       @default(0.7)
  openingMessage String?     @db.Text
  contextLimit   Int         @default(20)
  status         AgentStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User            @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  workflows     AgentWorkflow[]
  workflowRuns  WorkflowRun[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  title     String?
  isPreview Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  workflowRuns WorkflowRun[]

  @@index([agentId])
  @@index([userId])
  @@index([agentId, userId, isPreview])
  @@index([agentId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  tokenUsage     Json?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Workflow {
  id                 String         @id @default(cuid())
  workspaceId        String
  creatorId          String
  name               String
  description        String?
  graph              Json
  status             WorkflowStatus @default(DRAFT)
  publishedVersionId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace        Workspace         @relation("WorkspaceWorkflows", fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User              @relation("WorkflowCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  publishedVersion WorkflowVersion?  @relation("PublishedWorkflowVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         WorkflowVersion[] @relation("WorkflowVersions")
  agentBindings    AgentWorkflow[]
  runs             WorkflowRun[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
  @@index([publishedVersionId])
}

model WorkflowVersion {
  id          String                @id @default(cuid())
  workflowId  String
  version     Int
  snapshot    Json
  description String?
  status      WorkflowVersionStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime              @default(now())

  workflow           Workflow        @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  creator            User            @relation("WorkflowVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  publishedWorkflows Workflow[]      @relation("PublishedWorkflowVersion")
  agentBindings      AgentWorkflow[]
  runs               WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([createdBy])
}

model AgentWorkflow {
  id                String   @id @default(cuid())
  agentId           String
  workflowId        String
  workflowVersionId String
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)

  @@unique([agentId, workflowId])
  @@index([agentId])
  @@index([workflowId])
  @@index([workflowVersionId])
}

model WorkflowRun {
  id                String            @id @default(cuid())
  workflowId        String
  workflowVersionId String?
  agentId           String?
  userId            String
  conversationId    String?
  messageId         String?
  source            WorkflowRunSource @default(DEBUG)
  status            WorkflowRunStatus @default(RUNNING)
  input             Json?
  output            Json?
  errorMessage      String?           @db.Text
  startedAt         DateTime          @default(now())
  endedAt           DateTime?

  workflow        Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion?  @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  agent           Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user            User              @relation("WorkflowRunUser", fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message         Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  steps           WorkflowRunStep[]

  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([agentId])
  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@index([status])
  @@index([source])
  @@index([startedAt])
}

model WorkflowRunStep {
  id           String            @id @default(cuid())
  runId        String
  nodeId       String
  nodeType     String
  status       WorkflowRunStatus @default(RUNNING)
  input        Json?
  output       Json?
  errorMessage String?           @db.Text
  startedAt    DateTime          @default(now())
  endedAt      DateTime?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([nodeId])
  @@index([nodeType])
  @@index([status])
}
