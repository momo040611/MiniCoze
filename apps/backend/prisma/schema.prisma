generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  createdAgents  Agent[]
  createdPlugins PluginDefinition[]
  conversations  Conversation[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members           WorkspaceMember[]
  agents            Agent[]
  plugins           PluginDefinition[]
  pluginCredentials PluginCredential[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PluginType {
  BUILTIN
  HTTP
}

enum PluginStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum PluginToolStatus {
  ACTIVE
  DISABLED
}

enum AgentPluginBindingStatus {
  ACTIVE
  DISABLED
}

enum PluginInvocationStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  CANCELED
}

enum PluginCredentialStatus {
  ACTIVE
  DISABLED
}

model Agent {
  id             String      @id @default(cuid())
  workspaceId    String
  creatorId      String
  name           String
  description    String?
  avatarUrl      String?
  systemPrompt   String      @db.Text
  model          String      @default("deepseek-v4-flash")
  temperature    Float       @default(0.7)
  openingMessage String?     @db.Text
  contextLimit   Int         @default(20)
  status         AgentStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  conversations     Conversation[]
  pluginBindings    AgentPluginBinding[]
  pluginInvocations PluginInvocation[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  title     String?
  isPreview Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
  @@index([userId])
  @@index([agentId, userId, isPreview])
  @@index([agentId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  tokenUsage     Json?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model PluginDefinition {
  id                String       @id @default(cuid())
  workspaceId       String
  creatorId         String
  code              String
  name              String
  description       String?      @db.Text
  iconUrl           String?
  type              PluginType
  status            PluginStatus @default(DRAFT)
  version           String       @default("v1.0.0")
  isBuiltin         Boolean      @default(false)
  maskStrategy      Json?
  invocationEnabled Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  tools       PluginTool[]
  bindings    AgentPluginBinding[]
  credentials PluginCredential[]
  invocations PluginInvocation[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model PluginTool {
  id           String           @id @default(cuid())
  pluginId     String
  code         String
  name         String
  description  String           @db.Text
  status       PluginToolStatus @default(ACTIVE)
  inputSchema  Json
  outputSchema Json?
  meta         Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, code])
  @@index([pluginId, status])
}

model AgentPluginBinding {
  id         String                   @id @default(cuid())
  agentId    String
  pluginId   String
  status     AgentPluginBindingStatus @default(ACTIVE)
  autoInvoke Boolean                  @default(true)
  sortOrder  Int                      @default(0)
  config     Json?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  agent  Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([agentId, pluginId])
  @@index([agentId, status])
  @@index([pluginId, status])
}

model PluginCredential {
  id              String                 @id @default(cuid())
  pluginId        String
  workspaceId     String
  name            String
  status          PluginCredentialStatus @default(ACTIVE)
  authType        String
  secretEncrypted String?                @db.Text
  config          Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  plugin    PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([pluginId, workspaceId, status])
}

model PluginInvocation {
  id             String                 @id @default(cuid())
  pluginId       String
  agentId        String?
  conversationId String?
  runId          String
  toolCode       String
  status         PluginInvocationStatus
  argsSummary    Json?
  outputSummary  Json?
  errorSummary   String?                @db.Text
  durationMs     Int?
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?

  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  agent  Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([pluginId, startedAt])
  @@index([agentId, startedAt])
  @@index([runId])
}
