generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  phone        String?
  bio          String?  @db.Text
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  createdAgents             Agent[]
  createdAgentVersions      AgentVersion[]      @relation("AgentVersionCreator")
  createdPlugins            PluginDefinition[]
  conversations             Conversation[]
  uploadedFiles             FileAsset[]         @relation("FileAssetOwner")
  createdKnowledgeBases     KnowledgeBase[]     @relation("KnowledgeBaseCreator")
  createdKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocumentCreator")
  createdWorkflows          Workflow[]          @relation("WorkflowCreator")
  createdWorkflowVersions   WorkflowVersion[]   @relation("WorkflowVersionCreator")
  workflowRuns              WorkflowRun[]       @relation("WorkflowRunStarter")
  publishRecords            PublishRecord[]     @relation("PublishRecordOperator")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members            WorkspaceMember[]
  agents             Agent[]
  workflows          Workflow[]
  workflowRuns       WorkflowRun[]
  workflowVariables  WorkflowVariable[]
  files              FileAsset[]         @relation("WorkspaceFiles")
  plugins            PluginDefinition[]
  pluginCredentials  PluginCredential[]
  publishRecords     PublishRecord[]
  publishChannels    PublishChannel[]
  knowledgeBases     KnowledgeBase[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  @@index([ownerId])
}

enum FilePurpose {
  USER_AVATAR
  WORKSPACE_AVATAR
  AGENT_AVATAR
  PLUGIN_ICON
  KNOWLEDGE_DOCUMENT
  CHAT_ATTACHMENT
  WORKFLOW_ATTACHMENT
  TEMP_UPLOAD
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum FileStatus {
  READY
  DELETED
}

model FileAsset {
  id           String         @id @default(cuid())
  workspaceId  String?
  ownerId      String
  purpose      FilePurpose
  visibility   FileVisibility @default(PRIVATE)
  status       FileStatus     @default(READY)
  originalName String
  storageKey   String
  url          String?
  mimeType     String
  extension    String?
  size         Int
  checksum     String?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner              User                @relation("FileAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace          Workspace?          @relation("WorkspaceFiles", fields: [workspaceId], references: [id], onDelete: SetNull)
  knowledgeDocuments KnowledgeDocument[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([purpose])
  @@index([status])
  @@index([workspaceId, purpose])
  @@index([workspaceId, status])
  @@index([workspaceId, checksum])
  @@index([ownerId, createdAt])
  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PublishTargetType {
  AGENT
}

enum PublishAction {
  PUBLISH
  ROLLBACK
  OFFLINE
  ENABLE_CHANNEL
  DISABLE_CHANNEL
  UPDATE_CHANNEL
  ROTATE_API_KEY
}

enum PublishActionStatus {
  SUCCESS
  FAILED
}

enum PublishChannelType {
  WEB
  API
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WorkflowRunNodeStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// 持久化变量作用域：
// - SESSION：一次会话内（多轮对话）共享，scopeKey = sessionId
// - GLOBAL：跨会话永久保存（按用户维度），scopeKey = userId
enum WorkflowVariableScope {
  SESSION
  GLOBAL
}

enum PluginType {
  BUILTIN
  HTTP
}

enum PluginStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum PluginToolStatus {
  ACTIVE
  DISABLED
}

enum AgentPluginBindingStatus {
  ACTIVE
  DISABLED
}

enum PluginInvocationStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  CANCELED
}

enum PluginCredentialStatus {
  ACTIVE
  DISABLED
}

enum KnowledgeBaseStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  PARSED
  CHUNKED
  EMBEDDING
  READY
  FAILED
}

model Agent {
  id                    String                      @id @default(cuid())
  workspaceId           String
  creatorId             String
  name                  String
  description           String?
  avatarUrl             String?
  systemPrompt          String                      @db.Text
  model                 String                      @default("deepseek-v4-flash")
  temperature           Float                       @default(0.7)
  openingMessage        String?                     @db.Text
  contextLimit          Int                         @default(20)
  status                AgentStatus                 @default(DRAFT)
  currentVersionId      String?                     @unique
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator               User                        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  versions              AgentVersion[]              @relation("AgentVersions")
  currentVersion        AgentVersion?               @relation("AgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  conversations         Conversation[]
  workflows             AgentWorkflow[]
  workflowRuns          WorkflowRun[]
  pluginBindings        AgentPluginBinding[]
  pluginInvocations     PluginInvocation[]
  knowledgeBaseBindings KnowledgeBaseAgentBinding[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model AgentVersion {
  id          String    @id @default(cuid())
  agentId     String
  createdBy   String
  version     Int
  snapshot    Json
  changelog   String?   @db.Text
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent            Agent   @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  creator          User    @relation("AgentVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  currentForAgents Agent[] @relation("AgentCurrentVersion")

  @@unique([agentId, version])
  @@index([agentId])
  @@index([createdBy])
  @@index([agentId, publishedAt])
}

model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  title     String?
  isPreview Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  workflowRuns WorkflowRun[]

  @@index([agentId])
  @@index([userId])
  @@index([agentId, userId, isPreview])
  @@index([agentId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  metadata       Json?
  tokenUsage     Json?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Workflow {
  id               String         @id @default(cuid())
  workspaceId      String
  creatorId        String
  name             String
  description      String?
  status           WorkflowStatus @default(DRAFT)
  draftDefinition  Json?
  currentVersionId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User              @relation("WorkflowCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  versions       WorkflowVersion[] @relation("WorkflowVersions")
  runs           WorkflowRun[]
  agentBindings  AgentWorkflow[]
  currentVersion WorkflowVersion?  @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model WorkflowVersion {
  id           String    @id @default(cuid())
  workflowId   String
  createdBy    String
  version      Int
  definition   Json
  inputSchema  Json?
  outputSchema Json?
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflow            Workflow        @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  creator             User            @relation("WorkflowVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  runs                WorkflowRun[]
  agentBindings       AgentWorkflow[]
  currentForWorkflows Workflow[]      @relation("WorkflowCurrentVersion")

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([createdBy])
}

model AgentWorkflow {
  id                String   @id @default(cuid())
  agentId           String
  workflowId        String
  workflowVersionId String
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)

  @@unique([agentId, workflowId])
  @@index([agentId])
  @@index([workflowId])
  @@index([workflowVersionId])
}

model WorkflowRun {
  id                String            @id @default(cuid())
  workflowId        String
  workflowVersionId String?
  workspaceId       String
  agentId           String?
  conversationId    String?
  messageId         String?
  startedBy         String
  status            WorkflowRunStatus @default(QUEUED)
  input             Json?
  output            Json?
  errorMessage      String?           @db.Text
  startedAt         DateTime          @default(now())
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workflow        Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion?  @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent           Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message         Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  starter         User              @relation("WorkflowRunStarter", fields: [startedBy], references: [id], onDelete: Restrict)
  nodes           WorkflowRunNode[]

  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([workspaceId])
  @@index([agentId])
  @@index([conversationId])
  @@index([messageId])
  @@index([startedBy])
  @@index([workflowId, status])
  @@index([workflowId, startedAt])
}

model WorkflowRunNode {
  id           String                @id @default(cuid())
  runId        String
  nodeId       String
  nodeType     String
  status       WorkflowRunNodeStatus @default(PENDING)
  input        Json?
  output       Json?
  errorMessage String?               @db.Text
  durationMs   Int?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, status])
  @@index([runId, createdAt])
}

// 工作流持久化变量：实现“记忆”能力。
// scopeKey 区分同一作用域下的不同归属：SESSION 存 sessionId，GLOBAL 存 userId。
// (workspaceId, scope, scopeKey, name) 唯一确定一个变量。
model WorkflowVariable {
  id          String                @id @default(cuid())
  workspaceId String
  scope       WorkflowVariableScope
  scopeKey    String
  name        String
  value       Json
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, scopeKey, name])
  @@index([workspaceId, scope, scopeKey])
}

model PluginDefinition {
  id                String       @id @default(cuid())
  workspaceId       String
  creatorId         String
  code              String
  name              String
  description       String?      @db.Text
  iconUrl           String?
  type              PluginType
  status            PluginStatus @default(DRAFT)
  version           String       @default("v1.0.0")
  isBuiltin         Boolean      @default(false)
  maskStrategy      Json?
  invocationEnabled Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  tools       PluginTool[]
  bindings    AgentPluginBinding[]
  credentials PluginCredential[]
  invocations PluginInvocation[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model PluginTool {
  id           String           @id @default(cuid())
  pluginId     String
  code         String
  name         String
  description  String           @db.Text
  status       PluginToolStatus @default(ACTIVE)
  inputSchema  Json
  outputSchema Json?
  meta         Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, code])
  @@index([pluginId, status])
}

model AgentPluginBinding {
  id         String                   @id @default(cuid())
  agentId    String
  pluginId   String
  status     AgentPluginBindingStatus @default(ACTIVE)
  autoInvoke Boolean                  @default(true)
  sortOrder  Int                      @default(0)
  config     Json?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  agent  Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([agentId, pluginId])
  @@index([agentId, status])
  @@index([pluginId, status])
}

model PluginCredential {
  id              String                 @id @default(cuid())
  pluginId        String
  workspaceId     String
  name            String
  status          PluginCredentialStatus @default(ACTIVE)
  authType        String
  secretEncrypted String?                @db.Text
  config          Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  plugin    PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([pluginId, workspaceId, status])
}

model PluginInvocation {
  id             String                 @id @default(cuid())
  pluginId       String
  agentId        String?
  conversationId String?
  runId          String
  toolCode       String
  status         PluginInvocationStatus
  argsSummary    Json?
  outputSummary  Json?
  errorSummary   String?                @db.Text
  durationMs     Int?
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?

  plugin PluginDefinition @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  agent  Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([pluginId, startedAt])
  @@index([agentId, startedAt])
  @@index([runId])
}

model PublishRecord {
  id            String              @id @default(cuid())
  workspaceId   String
  targetType    PublishTargetType
  targetId      String
  versionId     String?
  versionNumber Int?
  action        PublishAction
  status        PublishActionStatus
  changelog     String?             @db.Text
  errorMessage  String?             @db.Text
  operatorId    String
  createdAt     DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operator  User      @relation("PublishRecordOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([targetType, targetId])
  @@index([versionId])
  @@index([operatorId])
  @@index([createdAt])
}

model PublishChannel {
  id          String             @id @default(cuid())
  workspaceId String
  targetType  PublishTargetType
  targetId    String
  channel     PublishChannelType
  enabled     Boolean            @default(false)
  config      Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, channel])
  @@index([workspaceId])
  @@index([targetType, targetId])
  @@index([channel, enabled])
}

model KnowledgeBase {
  id          String              @id @default(cuid())
  workspaceId String
  creatorId   String
  name        String
  description String?             @db.Text
  status      KnowledgeBaseStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User                        @relation("KnowledgeBaseCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  documents     KnowledgeDocument[]
  chunks        KnowledgeChunk[]
  agentBindings KnowledgeBaseAgentBinding[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model KnowledgeDocument {
  id              String                  @id @default(cuid())
  knowledgeBaseId String
  workspaceId     String
  fileId          String
  creatorId       String
  name            String
  status          KnowledgeDocumentStatus @default(UPLOADED)
  errorMessage    String?                 @db.Text
  chunkCount      Int                     @default(0)
  tokenCount      Int                     @default(0)
  chunkType       String?
  chunkConfig     Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  totalChars      Int                     @default(0)

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file          FileAsset        @relation(fields: [fileId], references: [id], onDelete: Restrict)
  creator       User             @relation("KnowledgeDocumentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  chunks        KnowledgeChunk[]

  @@unique([knowledgeBaseId, fileId])
  @@index([knowledgeBaseId])
  @@index([workspaceId])
  @@index([fileId])
  @@index([creatorId])
  @@index([status])
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  documentId      String
  knowledgeBaseId String
  workspaceId     String
  content         String   @db.Text
  index           Int
  tokenCount      Int      @default(0)
  enabled         Boolean  @default(true)
  metadata        Json?
  vectorId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document      KnowledgeDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase         @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vectorRecord  KnowledgeChunkVector?

  @@unique([documentId, index])
  @@index([documentId])
  @@index([knowledgeBaseId])
  @@index([workspaceId])
  @@index([vectorId])
}

model KnowledgeChunkVector {
  id            String                      @id @default(cuid())
  chunkId       String                      @unique
  embedderModel String
  dim           Int
  vector        Unsupported("vector(1024)")
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseAgentBinding {
  id              String   @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  enabled         Boolean  @default(true)
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeBaseId])
  @@index([agentId])
  @@index([knowledgeBaseId])
  @@index([agentId, enabled])
}
