generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  createdAgents Agent[]
  conversations Conversation[]
  uploadedFiles FileAsset[]       @relation("FileAssetOwner")
  createdWorkflows Workflow[]        @relation("WorkflowCreator")
  createdWorkflowVersions WorkflowVersion[] @relation("WorkflowVersionCreator")
  workflowRuns WorkflowRun[]         @relation("WorkflowRunStarter")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  agents       Agent[]
  workflows    Workflow[]
  workflowRuns WorkflowRun[]
  files        FileAsset[]       @relation("WorkspaceFiles")

  @@index([ownerId])
}

enum FilePurpose {
  USER_AVATAR
  WORKSPACE_AVATAR
  AGENT_AVATAR
  PLUGIN_ICON
  KNOWLEDGE_DOCUMENT
  CHAT_ATTACHMENT
  WORKFLOW_ATTACHMENT
  TEMP_UPLOAD
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum FileStatus {
  READY
  DELETED
}

model FileAsset {
  id           String         @id @default(cuid())
  workspaceId  String?
  ownerId      String
  purpose      FilePurpose
  visibility   FileVisibility @default(PRIVATE)
  status       FileStatus     @default(READY)
  originalName String
  storageKey   String
  url          String?
  mimeType     String
  extension    String?
  size         Int
  checksum     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner     User       @relation("FileAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation("WorkspaceFiles", fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([workspaceId])
  @@index([purpose])
  @@index([status])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WorkflowRunNodeStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Agent {
  id             String      @id @default(cuid())
  workspaceId    String
  creatorId      String
  name           String
  description    String?
  avatarUrl      String?
  systemPrompt   String      @db.Text
  model          String      @default("deepseek-v4-flash")
  temperature    Float       @default(0.7)
  openingMessage String?     @db.Text
  contextLimit   Int         @default(20)
  status         AgentStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  title     String?
  isPreview Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
  @@index([userId])
  @@index([agentId, userId, isPreview])
  @@index([agentId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  tokenUsage     Json?
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Workflow {
  id               String         @id @default(cuid())
  workspaceId      String
  creatorId        String
  name             String
  description      String?
  status           WorkflowStatus @default(DRAFT)
  draftDefinition  Json?
  currentVersionId String?       @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User              @relation("WorkflowCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  versions       WorkflowVersion[] @relation("WorkflowVersions")
  runs           WorkflowRun[]
  currentVersion WorkflowVersion?  @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  createdBy   String
  version     Int
  definition  Json
  inputSchema Json?
  outputSchema Json?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow            Workflow      @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  creator             User          @relation("WorkflowVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  runs                WorkflowRun[]
  currentForWorkflows Workflow[]    @relation("WorkflowCurrentVersion")

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([createdBy])
}

model WorkflowRun {
  id                String            @id @default(cuid())
  workflowId        String
  workflowVersionId String?
  workspaceId       String
  startedBy         String
  status            WorkflowRunStatus @default(QUEUED)
  input             Json?
  output            Json?
  errorMessage      String?           @db.Text
  startedAt         DateTime          @default(now())
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workflow        Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion?  @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  starter         User              @relation("WorkflowRunStarter", fields: [startedBy], references: [id], onDelete: Restrict)
  nodes           WorkflowRunNode[]

  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([workspaceId])
  @@index([startedBy])
  @@index([workflowId, status])
  @@index([workflowId, startedAt])
}

model WorkflowRunNode {
  id          String                @id @default(cuid())
  runId       String
  nodeId      String
  nodeType    String
  status      WorkflowRunNodeStatus @default(PENDING)
  input       Json?
  output      Json?
  errorMessage String?              @db.Text
  durationMs  Int?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, status])
  @@index([runId, createdAt])
}
