NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="2h"
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# 当前使用哪个供应商
AI_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === Knowledge / Embedding ===
# OpenAI 兼容 embedding 接口。常见可选：
#   硅基流动        https://api.siliconflow.cn/v1
#   阿里 DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI 官方     https://api.openai.com/v1
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 必须与所选模型实际维度匹配；bge-large-zh-v1.5 = 1024
EMBEDDING_DIM=1024
# 单次 embedding API 请求的 chunk 数；提供商各有上限，32 是稳健默认
EMBEDDING_BATCH_SIZE=32

# 上传 stage 文件存放目录（相对 backend 工作目录或绝对路径）。
# 服务启动时会自动 mkdir。需加入 .gitignore。
UPLOAD_STORAGE_DIR=./storage/uploads

