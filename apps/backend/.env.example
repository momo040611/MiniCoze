NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="2h"
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# 当前使用哪个供应商
AI_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Bing Web Search
BING_SEARCH_API_KEY=your-bing-search-key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
BING_SEARCH_TIMEOUT_MS=10000

# Image Understanding (OpenAI-compatible Vision)
IMAGE_UNDERSTANDING_API_KEY=your-vision-api-key
IMAGE_UNDERSTANDING_BASE_URL=https://api.openai.com/v1
IMAGE_UNDERSTANDING_MODEL=gpt-4o-mini
IMAGE_UNDERSTANDING_TIMEOUT_MS=20000

